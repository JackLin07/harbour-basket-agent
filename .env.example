# Copy this file to .env and fill in the provider you actually use.
# Never commit .env. The LLM client is provider-agnostic; start with one key.

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- xAI Grok (OpenAI-compatible; use the official OpenAI SDK with base_url) ---
# Get a key at https://console.x.ai/ — docs: https://docs.x.ai/docs/overview
# Defaults (override with LLM_MODEL / JUDGE_MODEL):
#   LLM_MODEL=grok-4.20-non-reasoning   # cheap, fast, tool-calling
#   JUDGE_MODEL=grok-4.7                # stronger model for the LLM-as-judge
# XAI_API_KEY=

# --- Azure OpenAI (a plus for the Coles AI Engineer role) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Which chat provider the stub factory should try first: openai | xai | azure | anthropic
LLM_PROVIDER=openai

# Optional generic model overrides (apply to openai and xai)
# LLM_MODEL=
# JUDGE_MODEL=

# Embedding backend for RAG: openai | azure | sentence-transformers | hashing
# "hashing" is a toy offline baseline so you can wire the retriever without a key.
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Agent / eval
MAX_TOOL_ITERS=6
EVAL_JUDGE_MODEL=
TRACE_DIR=evals/results/traces

# Optional override if you move the data folder
# HARBOUR_BASKET_DATA_DIR=/absolute/path/to/data
